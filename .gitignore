# Build and release outputs
/bin/
/dist/
/third_party_licenses/
# `go build` in the repository root
/remotesigner
/headercheck
# `go build` in tools/vectorgen or tools/vectorgen/contract: GPL-3.0 combined works that must never be committed or
# shipped
/tools/vectorgen/vectorgen
/tools/vectorgen/contract/contract

# Go tooling
*.test
*.prof

# Python bytecode from running the fixture generators
__pycache__/
*.pyc
# Coverage profiles and other outputs written in the repository root only, so
# source files such as internal/x/coverage.go are never ignored.
/*.out
/coverage.html

# Editors and OS files
.idea/
.vscode/
*.swp
.DS_Store
